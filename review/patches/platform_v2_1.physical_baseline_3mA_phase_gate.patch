+class CentreRecoveryGateTests(unittest.TestCase):
+    """The phase loop waits after an accepted centre change (config gate).
+
+    The guard ratchets the amplitude down on every frequency change and ramps
+    it back; a phase update taken on that ramp moves the centre again before
+    the last move has finished. The gate may only wait: it must not raise the
+    amplitude, take a larger step, probe more, or read anything a controller
+    is not allowed to read.
+    """
+
+    @staticmethod
+    def sample(t, a, f=900500., state='NORMAL', frozen=False):
+        return Measurement(t, f, a, 100., .003, .1, -1., 1e3, -10., True, state, frozen)
+
+    def run_phase(self, gate_on, ids):
+        cfg = copy.deepcopy(CFG)
+        cfg['phase_centre_recovery_gate'] = gate_on
+        e = Engine(cfg, ids, 'PHASE_FEEDBACK', 'TEST')
+        phi = float(model.response(900000, e.cases[BASE])['phase_deg'][0])
+        run_policy(Executor(e), 'PHASE_FEEDBACK', phi)
+        return e
+
+    def test_ready_needs_two_equal_amplitude_samples_at_the_new_centre(self):
+        g = CentreRecoveryGate(20000)
+        g.begin(0)
+        self.assertFalse(g.ready(self.sample(20000, .50), 900500., 20000))
+        self.assertFalse(g.ready(self.sample(40000, .55), 900500., 40000))   # still ramping
+        self.assertTrue(g.active)
+        self.assertTrue(g.ready(self.sample(60000, .55), 900500., 60000))    # plateau
+        self.assertFalse(g.active)
+
+    def test_a_non_comparable_sample_restarts_the_count(self):
+        g = CentreRecoveryGate(20000)
+        g.begin(0)
+        self.assertFalse(g.ready(self.sample(20000, .5), 900500., 20000))
+        # Frozen ramp sample, old centre, off-lattice time: none can be the pair.
+        self.assertFalse(g.ready(self.sample(40000, .5, state='RAMP_UP', frozen=True), 900500., 40000))
+        self.assertFalse(g.ready(self.sample(60000, .5), 900500., 60000))
+        self.assertFalse(g.ready(self.sample(80000, .5, f=900000.), 900500., 80000))
+        self.assertFalse(g.ready(self.sample(101500, .5), 900500., 101500))
+        self.assertTrue(g.active)
+        self.assertFalse(g.ready(self.sample(120000, .5), 900500., 120000))
+        self.assertTrue(g.ready(self.sample(140000, .5), 900500., 140000))
+
+    def test_gate_off_is_the_formal_phase_path(self):
+        e = self.run_phase(False, [BASE, 'CASE_FS_M5'])
+        names = {x['event'] for x in e.events}
+        self.assertIn('PHASE_UPDATE', names)
+        self.assertFalse({'CENTRE_RECOVERY_BEGIN', 'CENTRE_RECOVERY_COMPLETE',
+                          'CENTRE_RECOVERY_TRUNCATED'} & names)
+
+    def test_no_phase_probe_while_a_new_centre_is_recovering(self):
+        e = self.run_phase(True, [BASE, 'CASE_FS_M5'])
+        begins = [x for x in e.events if x['event'] == 'CENTRE_RECOVERY_BEGIN']
+        completes = [x for x in e.events if x['event'] == 'CENTRE_RECOVERY_COMPLETE']
+        self.assertTrue(begins)
+        self.assertTrue(completes)
+        for b in begins:
+            ends = [c['time_us'] for c in completes if c['time_us'] > b['time_us']]
+            end = min(ends) if ends else e.end
+            probes = [r for r in e.rows if r['kind'].startswith('PHASE_PROBE')
+                      and b['time_us'] <= r['start_us'] < end]
+            self.assertEqual(probes, [])
+        for c in completes:
+            pair = [r for r in e.rows if r['kind'] == 'CONTROL'
+                    and r['end_us'] in (c['time_us']-CFG['control_tick_us'], c['time_us'])]
+            self.assertEqual(len(pair), 2)
+            self.assertTrue(all(r['protection_state'] == 'NORMAL' and not r['frequency_frozen']
+                                and r['frequency_Hz'] == c['frequency_Hz'] for r in pair))
+            self.assertEqual(pair[0]['applied_amplitude'], pair[1]['applied_amplitude'])
+
+    def test_gate_only_waits(self):
+        on = self.run_phase(True, [BASE, 'CASE_FS_M5'])
+        off = self.run_phase(False, [BASE, 'CASE_FS_M5'])
+        for e in (on, off):
+            control = [r for r in e.rows if r['kind'] == 'CONTROL']
+            self.assertTrue(all(r['requested_amplitude'] == 1. for r in control))
+            self.assertTrue(all(r['applied_amplitude'] <= 1. for r in e.rows))
+            # One phase step at most between ordinary samples, never larger.
+            steps = [abs(b['frequency_Hz']-a['frequency_Hz']) for a, b in zip(control, control[1:])]
+            self.assertLessEqual(max(steps), CFG['phase_max_step_Hz']+1e-6)
+            probes = [r for r in e.rows if r['kind'].startswith('PHASE_PROBE')]
+            self.assertTrue(all(r['duration_us'] == CFG['scan_point_us'] for r in probes))
+
 
 if __name__ == '__main__':
     unittest.main(verbosity=2)
