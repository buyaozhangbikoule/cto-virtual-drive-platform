+@dataclass
+class CentreRecoveryGate:
+    """Hold the next phase update until the drive has settled at a new centre.
+
+    Every accepted frequency change goes through the common guard, which never
+    raises the amplitude on the tick that changes frequency (it lowers it
+    first, at the old frequency, when the new point allows less) and only
+    ramps it back afterwards, at its own rate, while the frequency is held.
+    A phase update taken before that ramp has finished moves the centre again
+    and the amplitude stays wherever it was last cut to -- the ratchet. The
+    gate waits for two consecutive ordinary 20 ms CONTROL samples at the new
+    centre that are NORMAL, unfrozen, valid and at the same applied amplitude.
+    It only waits: no extra amplitude, step, probe or model query. Ported
+    from the v2 candidate checked in review/22-23; its logs are byte-identical
+    to the candidate's (config: phase_centre_recovery_gate).
+    """
+    tick_us: int
+    active: bool = False
+    previous: Measurement | None = None
+    opened_us: int | None = None
+
+    def begin(self, now: int):
+        self.active = True
+        self.previous = None
+        self.opened_us = now
+
+    def ready(self, m: Measurement, target: float, now: int) -> bool:
+        comparable = (valid_measurement(m) and m.state == 'NORMAL' and not m.frozen
+                      and m.time_us == now and now % self.tick_us == 0
+                      and abs(m.frequency_Hz-target) <= 1e-7)
+        if not comparable:
+            self.previous = None
+            return False
+        p = self.previous
+        self.previous = m
+        if (p is not None and m.time_us-p.time_us == self.tick_us
+                and abs(p.frequency_Hz-target) <= 1e-7
+                and abs(m.amplitude-p.amplitude) <= 1e-12):
+            self.active = False
+            return True
+        return False
+
+
+def gated_phase_update(io: Executor, m: Measurement, target_phase: float,
+                       trusted_frequency: float, gate: CentreRecoveryGate) -> float:
+    """phase_update behind the centre recovery gate; the phase law is unchanged."""
+    eligible = (valid_measurement(m) and m.state == 'NORMAL' and not m.frozen
+                and m.time_us == io.time and abs(m.frequency_Hz-trusted_frequency) <= 1e-7)
+    if gate.active:
+        eligible = gate.ready(m, trusted_frequency, io.time)
+        if eligible:
+            io.event('CENTRE_RECOVERY_COMPLETE', frequency_Hz=trusted_frequency,
+                     amplitude=m.amplitude, wait_us=io.time-gate.opened_us,
+                     criterion='two_consecutive_valid_control_plateau_samples')
+    if not eligible:
+        if not gate.active and not valid_measurement(m):
+            io.event('PHASE_RECOVERY_INVALID_MEASUREMENT_WAIT')
+        return trusted_frequency
+    before = io.time
+    new = phase_update(io, m, target_phase, trusted_frequency)
+    if io.time > before:
+        # Probe time is already charged by the common Executor.
+        if new != trusted_frequency:
+            gate.begin(io.time)
+            io.event('CENTRE_RECOVERY_BEGIN', frequency_Hz=new,
+                     probe_duration_us=io.time-before)
+        else:
+            io.event('PHASE_NO_NEW_CENTRE_RETURN', frequency_Hz=trusted_frequency,
+                     probe_duration_us=io.time-before)
+    return new
+
+
