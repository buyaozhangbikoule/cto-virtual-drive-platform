+# ---------------------------------------------------------------------------
+# Power-drop-triggered capture and the second phase tracker
+# (config: phase_tracker = newton_v2).
+#
+# One capture procedure serves every controller that has to re-find the peak:
+# a global coarse pass over the band, a refinement whose step and point dwell
+# follow the measured peak width, a second-peak check, anchor re-measurements,
+# a final validation and a gain threshold before moving. It is started by a
+# measured power drop, never on a timer, and it reuses the scan failure
+# classes, budgets and latch above, so a failed capture is charged exactly
+# like a failed periodic scan. Every number is declared in config.json and
+# parameter_sources.json. They were not searched for a better score, but they
+# are not independent of the registered schedules either: logic defects found
+# while tracing those schedules were fixed, and one number
+# (phase_max_step_per_width) was changed for that reason; review/27 lists them.
+# ---------------------------------------------------------------------------
+
+PHASE_TRACKERS = ('gain_v1', 'newton_v2')
+PHASE_SIGNALS = ('input', 'port')
+PHASE_TARGET_POLICIES = ('frozen', 'relearn_after_capture')
+
+
+def phase_mode(cfg: dict) -> tuple[str, str, str]:
+    mode = (cfg.get('phase_tracker', 'gain_v1'), cfg.get('phase_signal', 'input'),
+            cfg.get('phase_target_policy', 'frozen'))
+    if (mode[0] not in PHASE_TRACKERS or mode[1] not in PHASE_SIGNALS
+            or mode[2] not in PHASE_TARGET_POLICIES):
+        raise ValueError(f'unknown phase feedback mode {mode!r}')
+    if mode[0] == 'gain_v1' and mode[1:] != ('input', 'frozen'):
+        # The fixed Hz/deg gain was declared for the input phase on one peak
+        # width; it is not carried over to another signal or target policy.
+        raise ValueError('phase_tracker gain_v1 supports only the input phase with a frozen target')
+    return mode
+
+
+def phase_of(m: Measurement, signal: str) -> float | None:
+    return m.phase_port_deg if signal == 'port' else m.phase_input_deg
+
+
+def comparable(m: Measurement | None, f: float, now: int, tick: int) -> bool:
+    """A sample a tracker may use: settled at f, ordinary, on the control lattice."""
+    return (valid_measurement(m) and m.state == 'NORMAL' and not m.frozen
+            and m.time_us == now and now % tick == 0 and abs(m.frequency_Hz-f) <= 1e-7)
+
+
+def soft_headroom(m: Measurement, cfg: dict) -> float | None:
+    """Amplitude at which this measured point would reach a soft limit (linear scaling)."""
+    if not valid_measurement(m):
+        return None
+    return min(cfg['voltage_soft_Vpp']*m.amplitude/m.vpp,
+               cfg['current_soft_Arms']*m.amplitude/m.irms)
+
+
+def safe_amplitude(cfg: dict, a_now: float, headrooms) -> float:
+    """Highest amplitude <= a_now that keeps probe_amplitude_margin under each known headroom."""
+    a = a_now
+    for c in headrooms:
+        if c is not None and finite(c):
+            a = min(a, (1-cfg['probe_amplitude_margin'])*c)
+    return max(a, 0.)
+
+
+def settle_dwell_us(cfg: dict, width_Hz: float | None) -> int:
+    """Point dwell from the loaded peak width: k time constants of 1/(pi*width).
+
+    Clipped to [capture_scan_dwell_min_us, scan_point_us]; scan_point_us is also the
+    dwell when no width is known. Only the time cost follows from this rule:
+    the quasi-steady model has no settling transient, so a dwell that is too
+    short for a real resonator would not show up here as a measurement error.
+    """
+    if width_Hz is None or not finite(width_Hz) or width_Hz <= 0:
+        return int(cfg['scan_point_us'])
+    k_tau = cfg['capture_scan_settle_time_constants']*1e6/(math.pi*width_Hz)
+    return int(min(cfg['scan_point_us'], max(cfg['capture_scan_dwell_min_us'], math.ceil(k_tau))))
+
+
+def peak_width(fs: list[float], g: list[float], i: int) -> float | None:
+    """Half-power width of g (power per unit amplitude squared) around the local
+    maximum reached uphill from index i, by linear interpolation of the crossings.
+
+    None when fewer than three points lie above half power (the level did not
+    resolve the peak) or neither crossing lies inside the window. With only one
+    crossing inside (a peak near the band or window edge) the width is twice
+    that half-width.
+    """
+    j = i
+    while True:
+        k = max((n for n in (j-1, j+1) if 0 <= n < len(g)), key=lambda n: g[n])
+        if g[k] <= g[j]:
+            break
+        j = k
+    half = g[j]/2
+    lo = j
+    while lo > 0 and g[lo] > half:
+        lo -= 1
+    hi = j
+    while hi < len(g)-1 and g[hi] > half:
+        hi += 1
+    if sum(1 for n in range(lo, hi+1) if g[n] > half) < 3:
+        return None
+    left = right = None
+    if g[lo] <= half:
+        left = fs[lo]+(half-g[lo])/(g[lo+1]-g[lo])*(fs[lo+1]-fs[lo])
+    if g[hi] <= half:
+        right = fs[hi]-(half-g[hi])/(g[hi-1]-g[hi])*(fs[hi]-fs[hi-1])
+    if left is not None and right is not None:
+        return float(right-left)
+    if left is not None:
+        return float(2*(fs[j]-left))
+    if right is not None:
+        return float(2*(right-fs[j]))
+    return None
+
+
+def coarse_peaks(scores: list[float], cfg: dict) -> list[int]:
+    """The best coarse point, then any separate local maximum nearly as high.
+
+    A 5 kHz pass can land beside a narrow peak and under-read it, and a broad
+    response can have two humps, so a second local maximum within
+    capture_scan_secondary_peak_ratio of the best and at least
+    capture_scan_peak_separation_steps away is refined too.
+    """
+    best = int(np.argmax(scores))
+    n = len(scores)
+    local = [i for i in range(n) if (i == 0 or scores[i] >= scores[i-1])
+             and (i == n-1 or scores[i] >= scores[i+1])]
+    others = sorted((i for i in local if abs(i-best) >= cfg['capture_scan_peak_separation_steps']
+                     and scores[i] >= cfg['capture_scan_secondary_peak_ratio']*scores[best]),
+                    key=lambda i: (-scores[i], i))
+    return [best]+others[:max(0, int(cfg['capture_scan_max_peaks'])-1)]
+
+
+class HeadroomMap:
+    """Soft-limit headroom measured by the last capture, used to choose probe and
+    move amplitudes. A prediction, not a guard: the common guard still checks
+    every command against the present plant. It is used only while it agrees
+    with what is measured now: any measured headroom off its prediction by more
+    than scan_validation_relative_tolerance, or any confirmed power change,
+    clears it, because both mean the load it was measured on has gone."""
+
+    def __init__(self):
+        self.f, self.c = [], []
+
+    def clear(self):
+        self.f, self.c = [], []
+
+    def check(self, f: float, measured: float | None, tolerance: float):
+        predicted = self.predict(f)
+        if predicted is not None and measured is not None and abs(measured/predicted-1) > tolerance:
+            self.clear()
+
+    def replace(self, pairs):
+        points = sorted({float(f): float(c) for f, c in pairs
+                         if c is not None and finite(f, c)}.items())
+        self.f = [p[0] for p in points]
+        self.c = [p[1] for p in points]
+
+    def predict(self, f: float) -> float | None:
+        if len(self.f) < 2 or not self.f[0] <= f <= self.f[-1]:
+            return None
+        return float(np.interp(f, self.f, self.c))
+
+
+def probe(io: Executor, f: float, a: float, kind: str, dwell: int) -> Measurement | None:
+    """One probe point at f and amplitude a.
+
+    A needed amplitude reduction is made first, at the present frequency, as
+    its own short action: the guard then never has to pre-empt the probe
+    (PREPARE) or open a soft hold for it (FOLDBACK) on a margin it was given.
+    Returns the probe sample only when it executed in full, NORMAL and
+    unfrozen at f.
+    """
+    drive = io.last
+    if drive is not None and a < drive.amplitude-1e-12:
+        io.execute(drive.frequency_Hz, a, 'AMPLITUDE_BACKOFF', dwell)
+    t0 = io.time
+    m = io.execute(f, a, kind, dwell)
+    ok = (m is not None and io.time-t0 == dwell and valid_measurement(m)
+          and m.state == 'NORMAL' and not m.frozen and abs(m.frequency_Hz-f) < 1e-7)
+    return m if ok else None
+
+
+def predicted_headroom(f: float, left: Measurement, right: Measurement,
+                       headroom: HeadroomMap, cfg: dict) -> float | None:
+    """Soft-limit headroom expected at f: the capture's map while it still agrees
+    with measurement, otherwise interpolated between the two probes just
+    measured, and beyond them the nearer probe's value. Never extrapolated: a
+    straight line carried far past two close probes can predict any value,
+    including none at all, and the guard is there for what a prediction misses."""
+    mapped = headroom.predict(f)
+    if mapped is not None:
+        return mapped
+    c_left, c_right = soft_headroom(left, cfg), soft_headroom(right, cfg)
+    f_left, f_right = left.frequency_Hz, right.frequency_Hz
+    if c_left is None or c_right is None or f_right <= f_left:
+        return None
+    return float(np.interp(f, [f_left, f_right], [c_left, c_right]))
+
+
+def prepare_move(io: Executor, f_new: float, headroom: float | None, dwell: int):
+    """Before the CONTROL action that changes frequency: when the new point's known
+    headroom is below the present amplitude, lower it here first, at the present
+    frequency, so that the frequency change itself is free and unfrozen."""
+    drive = io.last
+    if drive is None or abs(drive.frequency_Hz-f_new) <= 1e-7:
+        return
+    a = safe_amplitude(io.cfg, drive.amplitude, (headroom,))
+    if a < drive.amplitude-1e-12:
+        io.execute(drive.frequency_Hz, a, 'AMPLITUDE_BACKOFF', dwell)
+
+
+@dataclass(frozen=True)
+class CaptureResult:
+    ok: bool
+    frequency_Hz: float | None
+    reason: str
+    status: str = SCAN_SEARCH_FAILED
+    source: str = ''                     # SCAN, MEMORY or STAY when ok
+    score_W: float | None = None
+    width_Hz: float | None = None
+    measurement: Measurement | None = None   # sample at the chosen frequency
+    anchor_score_W: float | None = None
+    headroom: tuple = ()                 # (frequency_Hz, headroom) measured on the way
+    band_edge: bool = False
+    points: int = 0
+
+
+def capture(io: Executor, trusted_frequency: float, width_hint: float | None,
+            memory=(), noise: float = 0.) -> CaptureResult:
+    """Find the measured soft-feasible power maximum over the whole band.
+
+    1. Anchor at the trusted frequency. 2. Remembered operating points (when
+    the caller passes them): the best one whose power matches what it had when
+    remembered and beats the anchor by the gain threshold is taken without a
+    search.
+    3. Coarse pass at capture_scan_coarse_step_Hz over the band. 4. For the best
+    coarse point, and a second peak if one qualifies, refinements at 1/5 of
+    the previous step over +-1 previous step, until the step is below
+    capture_scan_refine_step_per_width of the estimated width or reaches
+    capture_scan_min_step_Hz. The anchor is re-measured after every level, as in
+    scan(). 5. Validation at the winner. 6. Gain threshold: a winner that does
+    not beat the anchor by capture_scan_gain_threshold (or noise_sigmas measured
+    difference sigmas, if larger) leaves the drive where it is (STAY).
+    All points are at capture_scan_amplitude = voltage_soft_Vpp/(2 x 100 Vpp):
+    it stays under the soft limits as long as the port voltage at a=1 is at
+    most twice nominal anywhere in the band (on the registered sets the worst
+    is 198.2 Vpp on the default baseline, 173.0 Vpp on the candidate); the
+    common guard still decides every point.
+    """
+    cfg = io.cfg
+    amp = cfg['capture_scan_amplitude']
+    lo, hi = float(cfg['frequency_min_Hz']), float(cfg['frequency_max_Hz'])
+    start_us = io.time
+    width = width_hint
+    dwell = settle_dwell_us(cfg, width)
+    gain = max(cfg['capture_scan_gain_threshold'], cfg['noise_sigmas']*noise)
+    seen = []
+    count = 0
+
+    def fail(reason, status):
+        return CaptureResult(False, None, reason, status, points=count)
+
+    def take(f, kind):
+        nonlocal count
+        if count >= cfg['scan_max_points'] or io.time-start_us >= cfg['scan_max_duration_us']:
+            return None, fail('SCAN_COST_CAP_REACHED', SCAN_SEARCH_FAILED)
+        p = io.point(f, amp, kind, dwell)
+        count += 1
+        if not p.ok:
+            return None, fail('INVALID_POINT_OR_PROTECTION_OR_END', p.status)
+        s = measured_score(p.measurement, cfg)
+        if s is None or not math.isfinite(s):
+            return None, fail('INVALID_POINT_OR_PROTECTION_OR_END', SCAN_INVALID)
+        seen.append((float(f), soft_headroom(p.measurement, cfg)))
+        return p.measurement, None
+
+    anchor, failed = take(trusted_frequency, 'CAPTURE_ANCHOR_START')
+    if failed:
+        return failed
+    # A capture may be asked for while the guard is still holding or ramping
+    # after a trip; Executor.point waits that out on the first point. The wait
+    # is logged like any other time but is not search cost, so the duration
+    # budget starts once the anchor has been measured.
+    start_us = io.time
+    latest_anchor = anchor
+    anchor_score = measured_score(anchor, cfg)
+
+    def recheck(kind, level_index, level_step):
+        nonlocal latest_anchor
+        m, failed = take(trusted_frequency, kind)
+        if failed:
+            return failed
+        latest_anchor = m
+        if changed_anchor(anchor, m, cfg):
+            io.event('SCAN_NONSTATIONARY_DETECTED', procedure='CAPTURE', stage=kind,
+                     level_index=level_index, level_step_Hz=level_step, walked_to_edge=False)
+            return fail('ANCHOR_CHANGED_OR_INVALID', SCAN_NONSTATIONARY)
+        return None
+
+    hits = []
+    for f_mem, s_mem, w_mem in memory:
+        m, failed = take(f_mem, 'CAPTURE_MEMORY')
+        if failed:
+            return failed
+        s = measured_score(m, cfg)
+        match = abs(s/s_mem-1) <= max(cfg['memory_match_tolerance'], cfg['noise_sigmas']*noise)
+        better = s >= (1+gain)*anchor_score
+        io.event('CAPTURE_MEMORY_CHECK', frequency_Hz=f_mem, remembered_score_W=s_mem,
+                 measured_score_W=s, anchor_score_W=anchor_score, match=match, better=better)
+        if match and better:
+            hits.append((s, -abs(f_mem-trusted_frequency), f_mem, w_mem, m))
+    if hits:
+        # The best match, not the first: two load states can share a power level.
+        s, _, f_mem, w_mem, m = max(hits, key=lambda h: (h[0], h[1]))
+        if abs(io.last.frequency_Hz-f_mem) > 1e-7:
+            again, failed = take(f_mem, 'CAPTURE_MEMORY')
+            if failed:
+                return failed
+            m, s = again, measured_score(again, cfg)
+        return CaptureResult(True, float(f_mem), 'MEMORY_RECALLED', SCAN_VALID, 'MEMORY', s,
+                             w_mem if w_mem is not None else width, m, anchor_score,
+                             tuple(seen), f_mem in (lo, hi), count)
+
+    step = float(cfg['capture_scan_coarse_step_Hz'])
+    fs = [float(f) for f in np.arange(lo, hi+step/2, step)]
+    if fs[-1] < hi:
+        fs.append(hi)
+    level = []
+    for f in fs:
+        m, failed = take(f, 'CAPTURE_POINT')
+        if failed:
+            return failed
+        level.append(m)
+    scores = [measured_score(m, cfg) for m in level]
+    if max(scores) <= 1e-15 or max(scores)-min(scores) <= max(scores)*1e-12:
+        return fail('FLAT_OR_NO_SIGNAL', SCAN_SEARCH_FAILED)
+    failed = recheck('CAPTURE_ANCHOR_LEVEL', 0, step)
+    if failed:
+        return failed
+    g = [m.p_port_W/m.amplitude**2 for m in level]
+    peaks = coarse_peaks(scores, cfg)
+    if len(peaks) > 1:
+        io.event('CAPTURE_MULTI_PEAK', frequencies_Hz=[fs[i] for i in peaks],
+                 scores_W=[scores[i] for i in peaks])
+    candidates = []
+    for rank, i in enumerate(peaks):
+        center, best_score = fs[i], scores[i]
+        w = peak_width(fs, g, i)
+        if w is not None and rank == 0:
+            width = w
+            dwell = settle_dwell_us(cfg, width)
+        current = step
+        level_index = 0
+        while ((w is None or current >= cfg['capture_scan_refine_step_per_width']*w)
+               and current > cfg['capture_scan_min_step_Hz']+1e-9):
+            level_index += 1
+            new = max(float(cfg['capture_scan_min_step_Hz']), current/cfg['capture_scan_refine_factor'])
+            for recentre in range(cfg['scan_max_recentres']+1):
+                xs = grid(center, current, new, lo, hi)
+                ms = []
+                for f in xs:
+                    m, failed = take(f, 'CAPTURE_POINT')
+                    if failed:
+                        return failed
+                    ms.append(m)
+                ss = [measured_score(m, cfg) for m in ms]
+                k = int(np.argmax(ss))
+                center, best_score = xs[k], ss[k]
+                if not (k in (0, len(xs)-1) and center not in (lo, hi)):
+                    break
+                io.event('SCAN_RECENTRE', procedure='CAPTURE', frequency_Hz=center, level_step_Hz=new)
+            wl = peak_width(xs, [m.p_port_W/m.amplitude**2 for m in ms], k)
+            if wl is not None:
+                w = wl
+                if rank == 0:
+                    width = w
+                    dwell = settle_dwell_us(cfg, width)
+            failed = recheck('CAPTURE_ANCHOR_LEVEL', level_index, new)
+            if failed:
+                return failed
+            current = new
+        candidates.append((best_score, center, w))
+    best_score, center, w = max(candidates, key=lambda c: (c[0], -abs(c[1]-trusted_frequency)))
+    if w is not None:
+        width = w
+    final, failed = take(center, 'CAPTURE_VALIDATE')
+    if failed:
+        return failed
+    score = measured_score(final, cfg)
+    if abs(score-best_score)/max(best_score, 1e-15) > cfg['scan_validation_relative_tolerance']:
+        failed = recheck('CAPTURE_ANCHOR_VALIDATE', -1, 0.)
+        return failed or fail('FINAL_VALIDATION_FAILED', SCAN_SEARCH_FAILED)
+    if score < (1+gain)*anchor_score:
+        stay = measured_score(latest_anchor, cfg)
+        return CaptureResult(True, float(trusted_frequency), 'GAIN_BELOW_THRESHOLD', SCAN_VALID,
+                             'STAY', stay, width, latest_anchor, anchor_score, tuple(seen),
+                             trusted_frequency in (lo, hi), count)
+    return CaptureResult(True, float(center), 'CAPTURED', SCAN_VALID, 'SCAN', score, width, final,
+                         anchor_score, tuple(seen), center in (lo, hi), count)
+
+
+class NoiseFloor:
+    """Scatter of consecutive comparable samples at one held point and amplitude.
+
+    1.4826*median(|d|) over the last noise_window_samples relative differences
+    estimates the standard deviation of a difference of two single samples;
+    zero until four differences exist. Two samples count as the same point when
+    their frequencies differ by at most noise_same_point_per_width of the peak
+    width (a tracker dithering on noise still yields an estimate; the true
+    power difference over that distance near a peak is about 0.04 %). A real
+    load step is one outlier and barely moves the median. Used only to widen
+    decision thresholds.
+
+    The phase scatter is kept the same way from pairs at exactly the same
+    frequency (near a narrow peak even 1 % of the width moves the phase by
+    degrees). It widens the newton_v2 deadband: a deadband below the phase
+    noise keeps the loop probing forever, and near a soft limit every probe
+    costs an amplitude dip that breaks the acceptance run (found by the
+    measurement-noise study, review/27).
+    """
+
+    def __init__(self, cfg: dict):
+        self.cfg = cfg
+        self.tick = cfg['control_tick_us']
+        self.window = int(cfg['noise_window_samples'])
+        self.d = []
+        self.phase_d = []
+        self.prev = None
+
+    def observe(self, m: Measurement | None, score: float | None, width: float | None = None,
+                phase: float | None = None):
+        if m is None or score is None:
+            self.prev = None
+            return
+        p, self.prev = self.prev, (m.time_us, m.frequency_Hz, m.amplitude, score, phase)
+        if p is None or m.time_us-p[0] != self.tick or abs(m.amplitude-p[2]) > 1e-12:
+            return
+        near = 1e-7 if width is None else self.cfg['noise_same_point_per_width']*width
+        if abs(m.frequency_Hz-p[1]) <= near and p[3] > 0:
+            self.d = (self.d+[(score-p[3])/p[3]])[-self.window:]
+        if abs(m.frequency_Hz-p[1]) <= 1e-7 and finite(phase, p[4]):
+            self.phase_d = (self.phase_d+[wrap_deg(phase-p[4])])[-self.window:]
+
+    @property
+    def sigma_diff(self) -> float:
+        return 0. if len(self.d) < 4 else 1.4826*float(np.median(np.abs(self.d)))
+
+    @property
+    def phase_sigma_deg(self) -> float:
+        """Single-sample phase scatter (degrees); zero until four differences exist."""
+        return 0. if len(self.phase_d) < 4 else 1.4826*float(np.median(np.abs(self.phase_d)))/math.sqrt(2)
+
+
+class PowerMonitor:
+    """Reference power and drop triggers from CONTROL samples at the held point.
+
+    After reset() the mean of reference_samples settled (comparable) samples
+    becomes the reference, together with the mean input impedance and the
+    frequency they were taken at. Then drop_confirm_samples consecutive valid
+    samples below (1 - capture_scan_drop_fraction) of the power ask for a
+    capture, and the same number off it by more than track_change_fraction
+    (either way; widened to noise_sigmas single-sample sigmas when the measured
+    scatter is larger) ask for local tracking. So does the same number, still
+    at the reference frequency, whose input impedance is off the reference by
+    more than impedance_change_fraction (same widening): a load can move the
+    peak away while the power at the held point hardly changes, and the
+    impedance there shows it. A reset may carry the value just measured at the
+    new point (the held score at a park, the validated score of a capture or
+    recall); a reference that then comes out off that value by the same
+    thresholds means the load changed in between, so the earlier value stays
+    the reference and the drop or change is reported at once instead of being
+    absorbed as the new normal. A change may be confirmed from samples the guard
+    is still holding or ramping: the score is per unit of soft-feasible drive,
+    so a load that has moved the peak away reads low at any amplitude, and
+    waiting for a recovery ramp to finish first would only delay the response.
+    """
+
+    def __init__(self, cfg: dict):
+        self.cfg = cfg
+        self.reset()
+
+    def reset(self, prior: float | None = None):
+        self.ref, self.zin, self.f, self.collect, self.low, self.off = None, None, None, [], 0, 0
+        self.prior = prior
+
+    def observe(self, m: Measurement, score: float, settled: bool, noise_diff: float) -> str | None:
+        cfg = self.cfg
+        zin = complex(m.zin_real, m.zin_imag)
+        if self.ref is None:
+            if settled:
+                self.collect.append((score, zin, m.frequency_Hz))
+                if len(self.collect) >= cfg['reference_samples']:
+                    self.ref = float(np.mean([c[0] for c in self.collect]))
+                    self.zin = complex(np.mean([c[1] for c in self.collect]))
+                    self.f = self.collect[-1][2]
+                    prior, self.prior = self.prior, None
+                    if prior is not None and prior > 0:
+                        n = cfg['drop_confirm_samples']
+                        ratio = self.ref/prior
+                        if ratio < 1-cfg['capture_scan_drop_fraction']:
+                            self.ref, self.low = prior, n
+                            return 'CAPTURE'
+                        if abs(ratio-1) > max(cfg['track_change_fraction'],
+                                              cfg['noise_sigmas']*noise_diff/math.sqrt(2)):
+                            self.ref, self.off = prior, n
+                            return 'TRACK'
+                    return 'REFERENCE'
+            return None
+        ratio = score/self.ref
+        widen = cfg['noise_sigmas']*noise_diff/math.sqrt(2)
+        track = max(cfg['track_change_fraction'], widen)
+        moved = (abs(m.frequency_Hz-self.f) <= 1e-7 and
+                 abs(zin-self.zin)/max(abs(self.zin), 1e-15) > max(cfg['impedance_change_fraction'], widen))
+        self.low = self.low+1 if ratio < 1-cfg['capture_scan_drop_fraction'] else 0
+        self.off = self.off+1 if abs(ratio-1) > track or moved else 0
+        if self.low >= cfg['drop_confirm_samples']:
+            return 'CAPTURE'
+        if self.off >= cfg['drop_confirm_samples'] and self.low == 0:
+            # A drop still being confirmed takes precedence: answering it as a
+            # mere change would accept the collapsed level as the new reference.
+            return 'TRACK'
+        return None
+
+
+class FrequencyMemory:
+    """The start point plus the last memory_size operating points, each with the
+    reference power learned there, the width estimate at the time and the
+    soft-limit headroom measured there.
+
+    An entry stands for a load state, not only a frequency: a newer reference
+    replaces an older one only when both its frequency (within merge_Hz) and
+    its power (within memory_match_tolerance) agree. The start point, learned
+    at the calibration state every schedule begins in, is never evicted.
+    """
+
+    def __init__(self, cfg: dict):
+        self.size = int(cfg['memory_size'])
+        self.tolerance = cfg['memory_match_tolerance']
+        self.start = None
+        self.recent = []
+
+    @property
+    def items(self) -> list:
+        return self.recent+([self.start] if self.start is not None else [])
+
+    def remember(self, f: float, score: float, width: float | None, headroom: float | None,
+                 merge_Hz: float):
+        entry = (float(f), float(score), width, headroom)
+        if self.start is None:
+            self.start = entry
+            return
+        same = lambda it: abs(it[0]-f) <= merge_Hz and abs(it[1]/score-1) <= self.tolerance  # noqa: E731
+        if same(self.start):
+            return
+        self.recent = ([entry]+[it for it in self.recent if not same(it)])[:self.size]
+
+
+class CaptureSupervisor:
+    """Width estimate, headroom map, memory, power monitor and the failure budget
+    around capture(); used by the phase tracker's relearn policy.
+
+    respond() is the one decision point. A confirmed change of either kind
+    first probes the remembered operating points at the present amplitude
+    (recall): a load that has come back to a remembered state is found in a
+    few probes and without lowering the drive. Only a confirmed drop goes on
+    to a full capture, and only after capture_scan_min_interval_us since the
+    previous one; a failed capture is retried on the scan budget's schedule.
+    """
+
+    def __init__(self, cfg: dict):
+        self.cfg = cfg
+        self.budget = ScanBudget(cfg)
+        self.memory = FrequencyMemory(cfg)
+        self.monitor = PowerMonitor(cfg)
+        self.noise = NoiseFloor(cfg)
+        self.headroom = HeadroomMap()
+        self.width = float(cfg['nominal_peak_width_Hz'])   # design value until a capture measures it
+        self.failed_episode = False
+        self.last_capture_end = None
+        self.recalled = False      # memory already probed for the change now being handled
+
+    @property
+    def latched(self) -> bool:
+        return self.budget.exhausted
+
+    def merge_Hz(self) -> float:
+        return max(self.cfg['capture_scan_min_step_Hz'], self.cfg['capture_scan_refine_step_per_width']*self.width)
+
+    def reset_reference(self, prior: float | None = None):
+        self.monitor.reset(prior)
+        self.recalled = False
+
+    def observe(self, io: Executor, m: Measurement, settled: bool, f_op: float) -> str | None:
+        score = measured_score(m, self.cfg)
+        verdict = self.monitor.observe(m, score, settled, self.noise.sigma_diff)
+        if verdict == 'REFERENCE':
+            self.memory.remember(f_op, self.monitor.ref, self.width, soft_headroom(m, self.cfg),
+                                 self.merge_Hz())
+            io.event('POWER_REFERENCE_LEARNED', frequency_Hz=f_op, reference_W=self.monitor.ref,
+                     samples=self.cfg['reference_samples'])
+            return None
+        n = self.cfg['drop_confirm_samples']
+        if (verdict == 'CAPTURE' and self.monitor.low == n) or (verdict == 'TRACK' and self.monitor.off == n):
+            # (also reached at once when a new reference contradicts the prior one)
+            io.event('POWER_CHANGE_DETECTED', trigger=verdict, frequency_Hz=f_op, score_W=score,
+                     reference_W=self.monitor.ref, ratio=score/self.monitor.ref)
+            self.headroom.clear()
+        return verdict
+
+    def check_headroom(self, m: Measurement | None):
+        if valid_measurement(m):
+            self.headroom.check(m.frequency_Hz, soft_headroom(m, self.cfg),
+                                self.cfg['scan_validation_relative_tolerance'])
+
+    def due(self, t: int, trigger: str | None, last: Measurement | None) -> bool:
+        """A retry when the budget allows it, or a confirmed drop after the minimum interval.
+
+        A capture may start while the guard is still holding or ramping after a
+        trip (its first point simply waits in Executor.point); it never starts
+        on an invalid sample, so not during HARD_TRIP or after a data fault.
+        """
+        if not valid_measurement(last) or not self.budget.can_start(t):
+            return False
+        if self.failed_episode:
+            return last.state == 'NORMAL' and not last.frozen
+        return trigger == 'CAPTURE' and (self.last_capture_end is None or
+                                         t-self.last_capture_end >= self.cfg['capture_scan_min_interval_us'])
+
+    def recall(self, io: Executor, f_op: float, last: Measurement) -> CaptureResult | None:
+        """Probe every remembered point at the present amplitude, keeping the
+        declared margin under the headroom measured there, and take the best one
+        whose power matches what was remembered and beats the present point by
+        the gain threshold. All are probed, not the first match: two load states
+        can share a power level by coincidence."""
+        cfg = self.cfg
+        now = measured_score(last, cfg)
+        noise = self.noise.sigma_diff
+        gain = max(cfg['capture_scan_gain_threshold'], cfg['noise_sigmas']*noise)
+        dwell = settle_dwell_us(cfg, self.width)
+        hits = []
+        for f, s_mem, w_mem, c_mem in self.memory.items:
+            if abs(f-f_op) <= self.merge_Hz():
+                continue
+            m = probe(io, f, safe_amplitude(cfg, last.amplitude, (c_mem,)), 'MEMORY_PROBE', dwell)
+            if m is None:
+                io.event('MEMORY_PROBE_FAILED', frequency_Hz=f)
+                break
+            s = measured_score(m, cfg)
+            match = abs(s/s_mem-1) <= max(cfg['memory_match_tolerance'], cfg['noise_sigmas']*noise)
+            better = s >= (1+gain)*now
+            io.event('CAPTURE_MEMORY_CHECK', procedure='RECALL', frequency_Hz=f, remembered_score_W=s_mem,
+                     measured_score_W=s, anchor_score_W=now, match=match, better=better)
+            if match and better:
+                hits.append((s, -abs(f-f_op), f, w_mem, m))
+        if not hits:
+            return None
+        s, _, f, w_mem, m = max(hits, key=lambda h: (h[0], h[1]))
+        if w_mem is not None:
+            self.width = float(w_mem)
+        self.reset_reference(prior=s)
+        io.event('MEMORY_RECALLED', frequency_Hz=f, score_W=s, previous_score_W=now, width_Hz=self.width)
+        if abs(io.last.frequency_Hz-f) > 1e-7:
+            # Probed earlier in this pass: the drive is elsewhere now. The CONTROL
+            # action that follows moves there; its headroom was measured just now.
+            prepare_move(io, f, soft_headroom(m, cfg), dwell)
+        return CaptureResult(True, float(f), 'MEMORY_RECALLED', SCAN_VALID, 'MEMORY', s,
+                             self.width, m, now)
+
+    def respond(self, io: Executor, f_op: float, trigger: str | None, last: Measurement | None,
+                settled: bool):
+        """Returns a CaptureResult to move to, 'FAILED' after a failed capture,
+        'NO_MEMORY_MATCH' after a recall that found nothing, or None."""
+        if self.failed_episode:
+            if self.due(io.time, None, last):
+                return self.attempt(io, f_op, 'RETRY', with_memory=False) or 'FAILED'
+            return None
+        if trigger is None:
+            return None
+        if not self.recalled and settled:
+            self.recalled = True
+            hit = self.recall(io, f_op, last)
+            # Nothing remembered fits: for a drop, the capture follows on a later
+            # sample, since the probes have just moved the drive.
+            return hit if hit is not None else 'NO_MEMORY_MATCH'
+        if trigger == 'CAPTURE' and self.due(io.time, trigger, last):
+            return self.attempt(io, f_op, trigger, with_memory=not self.recalled) or 'FAILED'
+        return None
+
+    def attempt(self, io: Executor, f_op: float, trigger: str | None,
+                with_memory: bool = True) -> CaptureResult | None:
+        cfg = self.cfg
+        self.budget.start(io.time)
+        start = io.time
+        io.event('SCAN_ATTEMPT_START', attempt=self.budget.attempts, trusted_frequency_Hz=f_op,
+                 procedure='CAPTURE', trigger=trigger, width_hint_Hz=self.width,
+                 dwell_us=settle_dwell_us(cfg, self.width))
+        memory = ([(f, s, w) for f, s, w, _ in self.memory.items if abs(f-f_op) > 1e-7]
+                  if with_memory else [])
+        result = capture(io, f_op, self.width, memory, self.noise.sigma_diff)
+        self.last_capture_end = io.time
+        if result.ok:
+            self.budget.success()
+            self.failed_episode = False
+            if result.width_Hz is not None:
+                self.width = float(result.width_Hz)
+            self.headroom.replace(result.headroom)
+            self.reset_reference(prior=result.score_W)
+            io.event('SCAN_SUCCESS', procedure='CAPTURE', frequency_Hz=result.frequency_Hz,
+                     band_edge=result.band_edge, source=result.source, reason=result.reason,
+                     score_W=result.score_W, anchor_score_W=result.anchor_score_W,
+                     width_Hz=self.width, points=result.points, duration_us=io.time-start)
+            return result
+        budget_class = self.budget.classify(result.status)
+        if budget_class is None:
+            io.event('SCAN_TRUNCATED_BY_RUN_END', procedure='CAPTURE', reason=result.reason,
+                     status=result.status, trusted_frequency_unchanged_Hz=f_op)
+            return None
+        self.budget.fail(budget_class, io.time)
+        self.failed_episode = True
+        io.event('SCAN_FAILURE', procedure='CAPTURE', reason=result.reason, status=result.status,
+                 budget_class=budget_class, trusted_frequency_unchanged_Hz=f_op,
+                 episode_failures_in_class=self.budget.episode[budget_class],
+                 class_limit=self.budget.limit[budget_class],
+                 total_failures=self.budget.total_failures,
+                 total_search=self.budget.total['search'],
+                 total_preemption=self.budget.total['preemption'],
+                 total_measurement=self.budget.total['measurement'],
+                 total_nonstationary=self.budget.total['nonstationary'],
+                 retry_not_before_us=self.budget.not_before)
+        if self.budget.exhausted:
+            io.event('SCAN_RETRIES_EXHAUSTED', procedure='CAPTURE', budget_class=self.budget.exhausted_class)
+        return None
+
