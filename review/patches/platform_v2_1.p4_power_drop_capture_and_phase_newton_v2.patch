+    f = np.arange(centre_Hz-300000., centre_Hz+300000., 1.)
+    p = model.response(f, case)['p_rm_W']
+    j = int(np.argmax(p))
+    half = p[j]/2
+    lo, hi = j, j
+    while p[lo] > half:
+        lo -= 1
+    while p[hi] > half:
+        hi += 1
+    return float((f[hi]-(half-p[hi])/(p[hi-1]-p[hi]))-(f[lo]+(half-p[lo])/(p[lo+1]-p[lo])))
 
 
