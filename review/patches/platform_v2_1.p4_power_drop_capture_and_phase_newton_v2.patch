+class Plateau:
+    """A held point is ready for the next comparison when its CONTROL sample is
+    comparable and at full amplitude, or, below full amplitude, when two
+    consecutive comparable samples one tick apart show the same amplitude (the
+    guard has stopped ramping). Waiting is all it does."""
+
+    def __init__(self, cfg: dict):
+        self.cfg = cfg
+        self.prev = None
+
+    def ready(self, m: Measurement | None, f: float, now: int) -> bool:
+        tick = self.cfg['control_tick_us']
+        if not comparable(m, f, now, tick):
+            self.prev = None
+            return False
+        p, self.prev = self.prev, m
+        if m.amplitude >= self.cfg['full_amplitude_threshold']:
+            return True
+        return (p is not None and m.time_us-p.time_us == tick and abs(p.frequency_Hz-f) <= 1e-7
+                and abs(m.amplitude-p.amplitude) <= 1e-12)
+
+
+def newton_phase_update(io: Executor, m: Measurement, signal: str, target: float,
+                        f_op: float, width: float, headroom: HeadroomMap,
+                        phase_sigma_deg: float = 0.) -> tuple[float, float | None]:
+    """Phase step that divides the error by the measured slope (newton_v2).
+
+    gain_v1 multiplies the error by a fixed Hz/deg gain. Its fraction of the
+    error corrected per update is gain*|slope|, which depends on the peak
+    width and the signal: about 43 % on the Qm=800 input phase, 0.1 % on the
+    input phase of a peak 40 times wider. The two executed neighbour probes
+    already measure the slope, so here the step is phase_newton_fraction of
+    error/slope, clipped to phase_max_step_per_width of the width; the probe
+    offset is phase_probe_offset_per_width of the width, never below
+    phase_probe_offset_Hz. Probes keep the declared margin under the measured
+    or mapped soft-limit headroom. The deadband is phase_deadband_deg or
+    noise_sigmas measured single-sample phase sigmas, whichever is larger.
+    Returns the new centre and the headroom predicted there (None when unknown).
+    """
+    cfg = io.cfg
+    error = wrap_deg(target-phase_of(m, signal))
+    if abs(error) <= max(cfg['phase_deadband_deg'], cfg['noise_sigmas']*phase_sigma_deg):
+        return f_op, None
+    delta = max(cfg['phase_probe_offset_Hz'], cfg['phase_probe_offset_per_width']*width)
+    lo = max(cfg['frequency_min_Hz'], f_op-delta)
+    hi = min(cfg['frequency_max_Hz'], f_op+delta)
+    dwell = settle_dwell_us(cfg, width)
+    c_now = soft_headroom(m, cfg)
+    left = right = None
+    if hi > lo:
+        left = probe(io, lo, safe_amplitude(cfg, m.amplitude, (c_now, headroom.predict(lo))),
+                     'PHASE_PROBE_MINUS', dwell)
+        if left is not None:
+            right = probe(io, hi, safe_amplitude(cfg, m.amplitude, (c_now, headroom.predict(hi))),
+                          'PHASE_PROBE_PLUS', dwell)
+    if (left is None or right is None or
+            not finite(phase_of(left, signal), phase_of(right, signal))):
+        io.event('PHASE_PROBE_FAILED', signal=signal)
+        return f_op, None
+    slope = wrap_deg(phase_of(right, signal)-phase_of(left, signal))/(hi-lo)
+    if not finite(slope) or abs(slope) < cfg['phase_slope_min_deg_per_Hz']:
+        io.event('PHASE_SLOPE_UNRESOLVED', signal=signal)
+        return f_op, None
+    limit = cfg['phase_max_step_per_width']*width
+    raw = f_op+float(np.clip(cfg['phase_newton_fraction']*error/slope, -limit, limit))
+    candidate = float(np.clip(raw, cfg['frequency_min_Hz'], cfg['frequency_max_Hz']))
+    if candidate != raw:
+        io.event('FREQUENCY_SATURATION', raw_frequency_Hz=raw)
+    io.event('PHASE_UPDATE', measured_error_deg=error, measured_slope_deg_per_Hz=slope,
+             proposed_frequency_Hz=candidate, signal=signal, law='newton_v2')
+    for probe_sample in (left, right):
+        headroom.check(probe_sample.frequency_Hz, soft_headroom(probe_sample, cfg),
+                       cfg['scan_validation_relative_tolerance'])
+    return candidate, predicted_headroom(candidate, left, right, headroom, cfg)
+
+
+def run_phase_v2(io: Executor):
+    """PHASE_FEEDBACK with phase_tracker = newton_v2.
+
+    The target is learned from the first comparable CONTROL sample at the start
+    frequency (the calibration state every schedule begins in). With
+    phase_target_policy = relearn_after_capture, a confirmed power change
+    first probes the remembered points (recall) and a confirmed drop then
+    starts a capture (CaptureSupervisor.respond); after either, the target is
+    re-learned from the sample at the chosen point and the monitor learns a new
+    reference there. A change that matches no remembered point is accepted as
+    the new reference. With frozen there is never a recall or capture, and the
+    first target is kept.
+    """
+    cfg = io.cfg
+    _, signal, policy = phase_mode(cfg)
+    relearn = policy == 'relearn_after_capture'
+    tick = cfg['control_tick_us']
+    low = cfg['capture_scan_amplitude']
+    sup = CaptureSupervisor(cfg)
+    plateau = Plateau(cfg)
+    f_op = float(cfg['initial_frequency_Hz'])
+    target = None
+    last = None
+    while not io.finished:
+        if relearn and sup.latched:
+            io.control(f_op, low, 'FAILED_SCAN_LATCHED_HOLD')
+            continue
+        if relearn and sup.failed_episode and not sup.budget.can_start(io.time):
+            last = io.control(f_op, low, 'FAILED_SCAN_RETRY_WAIT')
+            continue
+        usable = comparable(last, f_op, io.time, tick) and finite(phase_of(last, signal))
+        sup.noise.observe(last if usable else None, measured_score(last, cfg) if usable else None,
+                          sup.width, phase_of(last, signal) if usable else None)
+        sup.check_headroom(last if usable else None)
+        if usable and target is None:
+            target = float(phase_of(last, signal))
+            io.event('PHASE_TARGET_LEARNED', source='INITIAL_SAMPLE', signal=signal,
+                     target_deg=target, frequency_Hz=f_op)
+        here = (valid_measurement(last) and last.time_us == io.time
+                and abs(last.frequency_Hz-f_op) <= 1e-7)
+        if relearn and (here or sup.failed_episode):
+            trigger = sup.observe(io, last, usable, f_op) if here and not sup.failed_episode else None
+            outcome = sup.respond(io, f_op, trigger, last, usable)
+            if isinstance(outcome, CaptureResult):
+                f_op = float(outcome.frequency_Hz)
+                learned = phase_of(outcome.measurement, signal)
+                if finite(learned):
+                    target = float(learned)
+                    io.event('PHASE_TARGET_LEARNED', source=outcome.source, signal=signal,
+                             target_deg=target, frequency_Hz=f_op)
+                plateau.prev = None
+                if not io.finished:
+                    last = io.control(f_op, 1.)
+                continue
+            if outcome == 'FAILED':
+                # Never adopt a failed capture's last point as the new centre.
+                if not io.finished:
+                    last = io.control(f_op, low, 'FAILED_SCAN_ROLLBACK')
+                continue
+            if outcome == 'NO_MEMORY_MATCH':
+                if trigger == 'TRACK':
+                    sup.reset_reference()      # a new level, nothing remembered: accept it
+                plateau.prev = None
+                if not io.finished:
+                    last = io.control(f_op, 1.)
+                continue
+        if target is not None and usable and plateau.ready(last, f_op, io.time):
+            new, headroom = newton_phase_update(io, last, signal, target, f_op, sup.width, sup.headroom,
+                                                sup.noise.phase_sigma_deg)
+            if new != f_op:
+                prepare_move(io, new, headroom, settle_dwell_us(cfg, sup.width))
+                f_op = new
+        elif not usable:
+            plateau.prev = None
+        if not io.finished:
+            last = io.control(f_op, low if sup.failed_episode else 1.)
+
+
