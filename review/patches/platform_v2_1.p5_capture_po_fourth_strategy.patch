+# ---------------------------------------------------------------------------
+# CAPTURE_PO: power-drop-triggered capture plus perturb-and-observe tracking.
+# ---------------------------------------------------------------------------
+
+class PerturbObserve:
+    """Two-sided perturb-and-observe on the measured soft-feasible power.
+
+    Each comparison probes f_op - step and f_op + step (short probes, the same
+    probe rule as the phase tracker) and moves the held point only to a side
+    that beats the mean of the recent CONTROL samples there by po_move_threshold
+    (or noise_sigmas measured difference sigmas, if larger). A move grows the
+    step by po_grow, a comparison without one shrinks it by po_shrink; steps
+    stay within [po_step_min_per_width, po_step_max_per_width] x width and start
+    at po_step_initial_per_width x width. After po_park_comparisons comparisons
+    at the minimum step without a move the tracker parks: no more probes until
+    the power monitor reports a change. After a capture or a recall it starts
+    parked: the capture already placed the point within its final step, at
+    most capture_scan_refine_step_per_width of the width, and probing a point
+    that close to the peak can only cost samples. The width is the capture's
+    measured half-power width, or the nominal design width before any capture.
+    """
+
+    def __init__(self, cfg: dict):
+        self.cfg = cfg
+        self.parked = True
+        self.width = float(cfg['nominal_peak_width_Hz'])
+        self.step = None
+        self.quiet = 0
+        self.scores = []
+        self.held = None
+
+    def start(self, io: Executor, width: float, reason: str, f_op: float):
+        cfg = self.cfg
+        self.width = float(width)
+        self.step = self.width*cfg['po_step_initial_per_width']
+        self.parked, self.quiet, self.scores = False, 0, []
+        io.event('PO_START', reason=reason, frequency_Hz=f_op, step_Hz=self.step, width_Hz=self.width)
+
+    def hold(self, io: Executor, width: float, reason: str, f_op: float):
+        self.width = float(width)
+        self.step = self.width*self.cfg['po_step_initial_per_width']
+        self.parked, self.quiet, self.scores = True, 0, []
+        io.event('PO_PARK', reason=reason, frequency_Hz=f_op, step_Hz=self.step, width_Hz=self.width)
+
+    def bounds(self) -> tuple[float, float]:
+        return (self.width*self.cfg['po_step_min_per_width'],
+                self.width*self.cfg['po_step_max_per_width'])
+
+    def observe(self, score: float):
+        self.scores = (self.scores+[score])[-int(self.cfg['reference_samples']):]
+
+    def compare(self, io: Executor, f_op: float, last: Measurement,
+                sup: CaptureSupervisor) -> tuple[float, Measurement | None]:
+        cfg = io.cfg
+        lo_f, hi_f = float(cfg['frequency_min_Hz']), float(cfg['frequency_max_Hz'])
+        s0 = float(np.mean(self.scores)) if self.scores else measured_score(last, cfg)
+        dwell = settle_dwell_us(cfg, self.width)
+        c_now = soft_headroom(last, cfg)
+        smallest, largest = self.bounds()
+        results = []
+        for sign, kind in ((-1, 'PO_PROBE_MINUS'), (1, 'PO_PROBE_PLUS')):
+            f = float(np.clip(f_op+sign*self.step, lo_f, hi_f))
+            if abs(f-f_op) <= 1e-7:
+                continue
+            m = probe(io, f, safe_amplitude(cfg, last.amplitude, (c_now, sup.headroom.predict(f))),
+                      kind, dwell)
+            if m is None:
+                io.event('PO_PROBE_FAILED', frequency_Hz=f, step_Hz=self.step)
+                self.step = max(self.step*cfg['po_shrink'], smallest)
+                self.quiet = 0
+                return f_op, None
+            sup.check_headroom(m)
+            results.append((measured_score(m, cfg), f, m))
+        if not results:
+            return f_op, None
+        best_score, best_f, best_m = max(results, key=lambda r: (r[0], -abs(r[1]-f_op)))
+        margin = max(cfg['po_move_threshold'], cfg['noise_sigmas']*sup.noise.sigma_diff)
+        if best_score > s0*(1+margin):
+            io.event('PO_MOVE', from_frequency_Hz=f_op, to_frequency_Hz=best_f, score_W=best_score,
+                     held_score_W=s0, step_Hz=self.step, margin=margin)
+            self.step = min(self.step*cfg['po_grow'], largest)
+            self.quiet = 0
+            return best_f, best_m
+        at_minimum = self.step <= smallest*(1+1e-9)
+        self.step = max(self.step*cfg['po_shrink'], smallest)
+        self.quiet = self.quiet+1 if at_minimum else 0
+        self.held = s0
+        if self.quiet >= cfg['po_park_comparisons']:
+            self.parked = True
+            io.event('PO_PARK', reason='CONVERGED', frequency_Hz=f_op, step_Hz=self.step,
+                     width_Hz=self.width, held_score_W=s0)
+        return f_op, None
+
+
+def run_capture_po(io: Executor):
+    """CAPTURE_PO: perturb-and-observe tracking with power-drop-triggered capture.
+
+    Starts tracking at the start frequency with the nominal width (no capture
+    at t=0). A parked tracker restarts on a confirmed power change that no
+    remembered point explains; a confirmed drop goes to recall and then a full
+    capture (CaptureSupervisor.respond), after which the tracker holds the
+    chosen point, parked, with the measured width. Capture failures are charged to
+    the scan budgets and reach the same latched low hold as a periodic scan.
+    """
+    cfg = io.cfg
+    tick = cfg['control_tick_us']
+    low = cfg['capture_scan_amplitude']
+    sup = CaptureSupervisor(cfg)
+    po = PerturbObserve(cfg)
+    plateau = Plateau(cfg)
+    f_op = float(cfg['initial_frequency_Hz'])
+    po.start(io, sup.width, 'START', f_op)
+    last = None
+    while not io.finished:
+        if sup.latched:
+            io.control(f_op, low, 'FAILED_SCAN_LATCHED_HOLD')
+            continue
+        if sup.failed_episode and not sup.budget.can_start(io.time):
+            last = io.control(f_op, low, 'FAILED_SCAN_RETRY_WAIT')
+            continue
+        usable = comparable(last, f_op, io.time, tick)
+        score = measured_score(last, cfg) if usable else None
+        sup.noise.observe(last if usable else None, score, sup.width)
+        sup.check_headroom(last if usable else None)
+        if usable:
+            po.observe(score)
+        here = (valid_measurement(last) and last.time_us == io.time
+                and abs(last.frequency_Hz-f_op) <= 1e-7)
+        if here or sup.failed_episode:
+            trigger = sup.observe(io, last, usable, f_op) if here and not sup.failed_episode else None
+            if trigger == 'TRACK' and not po.parked:
+                trigger = None             # already tracking: the change is the tracker's own
+            outcome = sup.respond(io, f_op, trigger, last, usable)
+            if isinstance(outcome, CaptureResult):
+                f_op = float(outcome.frequency_Hz)
+                po.hold(io, sup.width, outcome.source, f_op)
+                plateau.prev = None
+                if not io.finished:
+                    last = io.control(f_op, 1.)
+                continue
+            if outcome == 'FAILED':
+                # Never adopt a failed capture's last point as the new operating point.
+                if not io.finished:
+                    last = io.control(f_op, low, 'FAILED_SCAN_ROLLBACK')
+                continue
+            if outcome == 'NO_MEMORY_MATCH':
+                if trigger == 'TRACK':
+                    po.start(io, sup.width, 'POWER_CHANGE', f_op)
+                plateau.prev = None
+                po.scores = []
+                if not io.finished:
+                    last = io.control(f_op, 1.)
+                continue
+            if trigger == 'TRACK' and po.parked and sup.recalled:
+                po.start(io, sup.width, 'POWER_CHANGE', f_op)
+        if not po.parked and usable and plateau.ready(last, f_op, io.time):
+            new, sample = po.compare(io, f_op, last, sup)
+            if new != f_op:
+                prepare_move(io, new, soft_headroom(sample, cfg), settle_dwell_us(cfg, po.width))
+                f_op = new
+                po.scores = []
+            if po.parked:
+                # Learn the parked level (the memory keeps it), checked against
+                # the held score the last comparison measured.
+                sup.reset_reference(prior=po.held)
+        elif not usable:
+            plateau.prev = None
+        if not io.finished:
+            last = io.control(f_op, low if sup.failed_episode else 1.)
+
+
 def run_policy(io: Executor, strategy: str, target_phase: float):
     if strategy not in STRATEGIES:
