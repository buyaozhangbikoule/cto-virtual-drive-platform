+        model.configure(cfg)
+        refs = references(cfg)
+        for strategy in STRATEGIES:
+            with self.subTest(strategy=strategy):
+                e = Engine(copy.deepcopy(cfg), [BASE, 'CASE_COMBINED_HIGH'], strategy, 'TEST')
+                run_policy(Executor(e), strategy, float(model.response(900000, e.cases[BASE])['phase_deg'][0]))
+                per, overall = evaluate(e.rows, e.events, cfg, refs)
+                self.assertEqual(overall['logged_duration_s'], 1.6)
+
+
 if __name__ == '__main__':
     unittest.main(verbosity=2)
