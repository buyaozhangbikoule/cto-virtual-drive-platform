+# A single scan_failures column cannot be read: a protection pre-emption, a data
+# fault, a plant that moved under the scan, and a search that ran out of budget
+# are different events with different owners. Count them separately and keep the
+# total, so the existing column still means exactly what it meant before.
+SCAN_FAILURE_CLASSES = ('search', 'preemption', 'measurement', 'nonstationary')
+
+
+def count_scan_failures(events, start, end) -> dict:
+    per = {k: 0 for k in SCAN_FAILURE_CLASSES}
+    for e in events:
+        if start <= e['time_us'] < end and e['event'] == 'SCAN_FAILURE':
+            # A failure with no class is an old-format log; count it as a search
+            # failure rather than dropping it.
+            per[e.get('budget_class', 'search')] += 1
+    return {f'scan_failures_{k}': v for k, v in per.items()}
+
