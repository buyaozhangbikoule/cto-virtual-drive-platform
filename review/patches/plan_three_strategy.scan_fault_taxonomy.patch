+    def test_a_stationary_plant_never_reports_nonstationary(self):
+        e = self.engine()
+        r = scan(Executor(e), 900000)
+        self.assertTrue(r.ok)
+        self.assertEqual(r.status, 'VALID_LOCAL_CANDIDATE')
