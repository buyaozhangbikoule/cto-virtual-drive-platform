+    def limit_probe(self, frequency_hz: float, scenario, requested: float) -> tuple[float, int]:
+        """Clamp a scan probe to the same limits the drive obeys.
+
+        The plan requires every scan and trial sample to pass the same protection
+        chain as a control sample.  What that has to mean is the limits, not the
+        state machine.  Feeding a probe to ``apply`` would let a 0.40 request
+        write ``applied_amplitude`` and clear ``SOFT_FOLDBACK``, erasing the very
+        foldback the protection is holding, so a probe is limited here and leaves
+        the state untouched.  A scan can only start when ``tracking_allowed`` is
+        true, so there is no HARD_TRIP or RECOVERY_HOLD to respect at this point.
+
+        ``normalized_port_power_W`` divides by the applied amplitude squared, so a
+        clipped probe stays comparable with an unclipped one and the scan's
+        argmax is unaffected by clipping.
+        """
+        soft_allow = float(allowed_amplitude(frequency_hz, scenario, use_soft_limits=True)[0])
+        applied = min(requested, soft_allow)
+        return applied, int(applied < requested - 1e-12)
