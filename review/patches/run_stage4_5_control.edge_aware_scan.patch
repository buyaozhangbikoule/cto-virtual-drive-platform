+    def sweep(label: str, center: float, span: float, step: float,
+              t_now: float) -> tuple[float, bool, float]:
+        """Measure one level and return its argmax, an edge-hit flag and the new time.
+
+        The three levels were previously written out three times.  They are one
+        function now so that a change to the sweep cannot be applied to two of
+        them and forgotten on the third.
+
+        The edge flag is the part that was missing.  When the true peak lies
+        outside the window the response is monotone across the whole window, so
+        the argmax pins to the near edge and the level silently reports a
+        boundary point as a maximum.  Landing on the 0.8 or 1.0 MHz band limit is
+        not the same thing: there is nowhere further to look, so it is not an
+        edge hit.
+        """
+        lo, hi = max(F_MIN, center - span), min(F_MAX, center + span)
+        grid = np.arange(lo, hi + 1, step)
+        measured = []
+        for f in grid:
+            seg = schedule_at(t_now)
+            scenario = scenarios[seg["case_id"]]
+            opt = optima[seg["case_id"]]
+            amplitude, clipped = protection.limit_probe(float(f), scenario, PROBE_AMPLITUDE)
+            row = measure(t_now, SCAN_POINT_DT, strategy, label, float(f), amplitude,
+                          protection.state, 0, clipped, True, seg, scenario, opt, reason)
+            rows.append(row)
+            measured.append((row["normalized_port_power_W"], float(f)))
+            t_now += SCAN_POINT_DT
+        best = max(measured)[1]
+        index = [value[1] for value in measured].index(best)
+        at_band_limit = (
+            (index == 0 and abs(grid[0] - F_MIN) < EDGE_TOLERANCE_HZ)
+            or (index == len(grid) - 1 and abs(grid[-1] - F_MAX) < EDGE_TOLERANCE_HZ)
+        )
