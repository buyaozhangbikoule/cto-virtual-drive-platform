+class SyntheticCandidateTests(unittest.TestCase):
+    """The Q=13.8 / 3 mA synthetic candidate is selectable but never the default.
+
+    It is a constructed circuit for broad-peak algorithm comparison, not a fit
+    to any device; its current limits act at the transducer port, which is
+    only one reading of the user's 5 mA upper limit.
+    """
+
+    def setUp(self):
+        self.addCleanup(model.configure, CFG)
+        self.cfg = json.loads(CANDIDATE.read_text(encoding='utf-8'))
+        model.configure(self.cfg)
+        self.cal = json.loads((ROOT/self.cfg['baseline_calibration_file']).read_text(encoding='utf-8'))
+
+    def test_default_configuration_does_not_use_the_candidate(self):
+        self.assertNotEqual(CFG['baseline_design_file'], self.cfg['baseline_design_file'])
+        self.assertNotIn('candidates/', CFG['baseline_design_file'])
+
+    def test_candidate_baseline_and_design_point(self):
+        design = json.loads((ROOT/self.cfg['baseline_design_file']).read_text(encoding='utf-8'))
+        self.assertEqual(model.BASELINE_ID, design['model_id'])
+        self.assertTrue(model.BASELINE_ID.startswith('SYNTHETIC_CANDIDATE'))
+        self.assertEqual(model.BASE_BVD.qm, design['bvd']['Qm'])
+        e = Engine(copy.deepcopy(self.cfg), [BASE], 'FIXED', 'TEST')
+        m = e.execute(900000, 1, 'CONTROL', 20000)
+        self.assertAlmostEqual(m.vpp, 100, places=6)
+        self.assertAlmostEqual(m.irms, self.cal['transducer_Irms_A'], places=12)
+        self.assertAlmostEqual(m.p_port_W, self.cal['P_port_W'], places=12)
+        # Inside its own limits, which act at the transducer port ...
+        self.assertLess(m.vpp, self.cfg['voltage_soft_Vpp'])
+        self.assertLess(m.irms, self.cfg['current_soft_Arms'])
+        # ... while the amplifier output current is far above 5 mA and only reported.
+        row = e.rows[-1]
+        amp = abs(complex(row['i_source_real_Arms'], row['i_source_imag_Arms']))
+        self.assertAlmostEqual(amp, self.cal['amplifier_output_Irms_A'], places=12)
+        self.assertGreater(amp, self.cfg['current_hard_Arms'])
+
+    def test_candidate_qm_family_is_relative(self):
+        cases = model.scenario_map()
+        self.assertIs(cases[BASE].bvd, model.BASE_BVD)
+        self.assertAlmostEqual(cases['CASE_QM_500'].bvd.qm/model.BASE_BVD.qm, .625, places=12)
+        self.assertEqual(cases['CASE_QM_800'].bvd.qm, model.BASE_BVD.qm)
+
+    def test_candidate_enables_the_gate(self):
+        self.assertIs(self.cfg['phase_centre_recovery_gate'], True)
+        e = Engine(copy.deepcopy(self.cfg), [BASE, 'CASE_FS_M3'], 'PHASE_FEEDBACK', 'TEST')
+        phi = float(model.response(900000, e.cases[BASE])['phase_deg'][0])
+        run_policy(Executor(e), 'PHASE_FEEDBACK', phi)
+        names = [x['event'] for x in e.events]
+        self.assertIn('CENTRE_RECOVERY_BEGIN', names)
+        self.assertIn('CENTRE_RECOVERY_COMPLETE', names)
+
 
