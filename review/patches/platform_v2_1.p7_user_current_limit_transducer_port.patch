+class UserCurrentLimitTests(unittest.TestCase):
+    """User 5 mA RMS upper limit, measured at the transducer port (confirmed 2026-10-16): checked and reported only."""
+
+    def setUp(self):
+        self.cand = json.loads(CANDIDATE.read_text(encoding='utf-8'))
+
+    @staticmethod
+    def row(i, dt, p=.1, pre=False, pre_i=0.):
+        return dict(iport_Arms=i, duration_us=dt, p_rm_W=p, pre_guard_sample_here=pre, pre_guard_iport_Arms=pre_i)
+
+    def test_both_configurations_record_the_limit_at_the_transducer_port(self):
+        for cfg in (CFG, self.cand):
+            with self.subTest(version=cfg['version']):
+                self.assertEqual(cfg['user_current_limit_Arms'], .005)
+                self.assertTrue(cfg['current_limit_measurement_point'].startswith('transducer_port'))
+                self.assertIn('confirmed', cfg['current_limit_measurement_point'])
+                for stale in ('no stated', 'unspecified', 'one interpretation'):
+                    self.assertNotIn(stale, cfg['current_limit_measurement_point'])
+                    self.assertNotIn(stale, cfg['user_boundaries'])
+        # The candidate's guard stays inside the limit; the historical default's does not.
+        self.assertLessEqual(self.cand['current_hard_Arms'], self.cand['user_current_limit_Arms'])
+        self.assertGreater(CFG['current_soft_Arms'], CFG['user_current_limit_Arms'])
+
+    def test_check_counts_rows_strictly_above_the_limit(self):
+        rows = [self.row(.004, 20000, pre=True, pre_i=.0062), self.row(.005, 20000), self.row(.0051, 10000, p=.2)]
+        c = user_limit_check(rows, .005)
+        self.assertEqual((c['rows'], c['rows_above'], c['time_us'], c['time_above_us']), (3, 1, 50000, 10000))
+        self.assertAlmostEqual(c['energy_J'], .1*.04+.2*.01, places=15)
+        self.assertAlmostEqual(c['energy_above_J'], .2*.01, places=15)
+        self.assertAlmostEqual(c['peak_post_guard_mArms'], 5.1, places=12)
+        self.assertEqual(c['pre_guard_predictions_above'], 1)
+        self.assertAlmostEqual(c['peak_pre_guard_mArms'], 6.2, places=12)
+
+    def test_report_states_compliance_per_configuration(self):
+        self.assertIn('高于该上限', current_limit_line(CFG))
+        self.assertIn('不满足用户电流边界', current_limit_line(CFG))
+        self.assertIn('不超过该上限', current_limit_line(self.cand))
+        for cfg in (CFG, self.cand):
+            self.assertNotIn('未定', current_limit_line(cfg))
+        user = {('S', s): user_limit_check([self.row(.0051, 20000)], .005) for s in STRATEGIES}
+        refs = {BASE: dict(current_Arms=.0054, within_limit_fraction=.97), 'X': dict(current_Arms=.003, within_limit_fraction=1.)}
+        text = '\n'.join(user_limit_lines(CFG, user, refs))
+        for s in STRATEGIES:
