+        self.assertEqual(EXTRA_STRATEGIES, ('ADMITTANCE_TRACK',))
+        with self.assertRaises(ValueError):
+            run_policy(Executor(Engine(copy.deepcopy(self.cfg), [BASE], 'X', 'TEST')), 'X', 0.)
+
+    def test_fit_and_updates(self):
+        true = AM.design_prior()
+        f = np.linspace(850e3, 950e3, 21)
+        est, residual = AM.fit_bvd(f, [AM.admittance(x, true) for x in f])
+        self.assertLess(residual, 1e-9)
+        for a, b in ((est.c0, true.c0), (est.rm, true.rm), (est.lm, true.lm), (est.cm, true.cm)):
+            self.assertAlmostEqual(a/b, 1., places=6)
+        # One point with Lm held finds a shifted fs exactly while Lm is unchanged ...
+        moved = replace(true, cm=true.cm/1.1)
+        one = AM.update(true, [(9e5, AM.motional(9e5, AM.admittance(9e5, moved), true.c0))], .25)
+        self.assertAlmostEqual(one.fs/moved.fs, 1., places=9)
+        # ... and two points far enough apart find a changed Lm as well.
+        both = replace(true, lm=true.lm*1.2)
+        pts = [(x, AM.motional(x, AM.admittance(x, both), true.c0)) for x in (9e5, both.fs+.3*both.width)]
+        two = AM.update(true, pts, .25)
+        self.assertAlmostEqual(two.lm/both.lm, 1., places=9)
+        self.assertAlmostEqual(two.fs/both.fs, 1., places=9)
+
+    def test_it_follows_an_fs_shift_in_two_moves_without_a_capture(self):
+        e = self.run_track([BASE, 'CASE_FS_M5'])
+        moves = [x for x in e.events if x['event'] == 'ADMITTANCE_MOVE' and x['time_us'] >= self.cfg['segment_us']]
+        self.assertEqual(len(moves), 2)
+        self.assertNotIn('SCAN_ATTEMPT_START', [x['event'] for x in e.events])
+        self.assertLessEqual(abs(moves[-1]['to_frequency_Hz']-self.refs['CASE_FS_M5']['policy']['frequency_Hz']), 100.)
+        per, _ = evaluate(e.rows, e.events, self.cfg, self.refs)
+        self.assertTrue(per[1]['settled'])
+        self.assertLessEqual(per[1]['sustained_recovery_level_ms'], 40.)
