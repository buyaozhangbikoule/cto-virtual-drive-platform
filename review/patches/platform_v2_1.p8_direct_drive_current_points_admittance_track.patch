+    def test_a_load_that_comes_back_is_recognised_without_a_probe(self):
+        # Lm +20 % and back: the remembered design estimate predicts the first sample after the
+        # return, so the point goes straight back in one move, with no probe and no capture.
+        e = self.run_track([BASE, 'CASE_LM_P20', BASE])
+        late = [x for x in e.events if x['time_us'] >= 2*self.cfg['segment_us']]
+        match = [x for x in late if x['event'] == 'ADMITTANCE_MEMORY_MATCH']
+        self.assertEqual(len(match), 1)
+        self.assertAlmostEqual(match[0]['fs_Hz'], model.BASE_BVD.fs, places=6)
+        self.assertEqual(len([x for x in late if x['event'] == 'ADMITTANCE_MOVE']), 1)
+        self.assertFalse(any(r['kind'] not in ('CONTROL', 'AMPLITUDE_BACKOFF')
+                             for r in e.rows if r['start_us'] >= 2*self.cfg['segment_us']))
+        per, _ = evaluate(e.rows, e.events, self.cfg, self.refs)
+        self.assertLessEqual(per[2]['sustained_recovery_level_ms'], 20.)
