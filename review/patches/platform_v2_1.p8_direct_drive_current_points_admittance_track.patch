+    def test_a_model_move_that_measures_worse_is_undone(self):
+        # Force one wrong model move on the baseline: the next sample is worse, the move is undone,
+        # model moves are suspended and P&O takes over from the old point.
+        real = AdmittanceTracker.observe
+        calls = []
+
+        def wrong_once(tracker, io, m, f_op):
+            if not calls and m.time_us >= 100000:
+                calls.append(f_op)
+                tracker.level = 1.
+                return 'MOVE', f_op+20000., False
+            return real(tracker, io, m, f_op)
+        with patch.object(AdmittanceTracker, 'observe', wrong_once):
+            e = self.run_track([BASE])
+        undone = [x for x in e.events if x['event'] == 'ADMITTANCE_MOVE_UNDONE']
+        self.assertEqual(len(undone), 1)
+        self.assertEqual(undone[0]['to_frequency_Hz'], calls[0])
+        self.assertIn('ADMITTANCE_UNDONE', [x.get('reason') for x in e.events if x['event'] == 'PO_START'])
+        per, _ = evaluate(e.rows, e.events, self.cfg, self.refs)
+        self.assertTrue(per[0]['settled'])
+
+    def test_a_network_change_alone_never_moves_the_point(self):
+        # Default baseline, Lmatch +10 %: the port admittance is unchanged, only k moves.
