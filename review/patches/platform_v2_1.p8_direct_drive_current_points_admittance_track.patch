+    def test_a_lower_peak_is_explained_without_a_capture(self):
+        # Rm +50 %: the peak stays where it is and drops by a third. The model explains the
+        # level and relearns the reference; CAPTURE_PO's power monitor reports a change.
+        e = self.run_track([BASE, 'CASE_RM_P50'])
+        late = [x for x in e.events if x['time_us'] >= self.cfg['segment_us']]
+        self.assertFalse({'SCAN_ATTEMPT_START', 'ADMITTANCE_MOVE', 'POWER_CHANGE_DETECTED'} & {x['event'] for x in late})
+        update = next(x for x in late if x['event'] == 'ADMITTANCE_MODEL_UPDATE')
+        self.assertAlmostEqual(update['rm_ohm']/model.BASE_BVD.rm, 1.5, places=9)
+        po = Engine(copy.deepcopy(self.cfg), [BASE, 'CASE_RM_P50'], 'CAPTURE_PO', 'TEST')
+        run_policy(Executor(po), 'CAPTURE_PO', 0.)
+        self.assertIn('POWER_CHANGE_DETECTED', [x['event'] for x in po.events])
