+    def test_an_implausible_update_falls_back_to_a_capture_and_refits(self):
+        # fs -5 % with C0 +30 %: away from the new peak the motional branch is too small to
+        # de-embed with the old C0; the update is refused and the capture finds the peak.
+        e = self.run_track([BASE, 'CASE_COMBINED_HIGH'])
+        lost = [x for x in e.events if x['event'] == 'ADMITTANCE_MODEL_LOST']
+        self.assertEqual(lost[0]['reason'], 'IMPLAUSIBLE_UPDATE')
+        start = next(x for x in e.events if x['event'] == 'SCAN_ATTEMPT_START')
+        self.assertEqual(start['trigger'], 'ADMITTANCE_LOST')
+        refit = next(x for x in e.events if x['event'] == 'ADMITTANCE_REFIT')
+        self.assertTrue(refit['adopted'])
+        self.assertAlmostEqual(refit['fs_Hz']/model.scenario_map()['CASE_COMBINED_HIGH'].bvd.fs, 1., places=6)
+        per, _ = evaluate(e.rows, e.events, self.cfg, self.refs)
+        self.assertTrue(per[1]['settled'])
