+"""De-embedded admittance model behind ADMITTANCE_TRACK (review/32).
+
+The controller's own plant model: an estimate of the BVD (C0, Rm, Lm, Cm)
+behind the DECLARED source and matching network, plus one measured scale
+factor k for what the declared network does not explain. It starts from the
+design file's BVD (design knowledge of the same kind as nominal_peak_width_Hz)
+and is then corrected only from Measurement fields: frequency, amplitude, vpp,
+irms, phase_port_deg and irms_source. It never sees a scenario.
+
+Conventions
+- phase_port_deg = arg(V_port/I_port) (engine.py); the port admittance is Y = I/V.
+- Motional impedance Zm = 1/(Y - j*w*C0) = R + jX with X = w*Lm - 1/(w*Cm).
+- With Lm known, one point's X gives 1/Cm = w*(w*Lm - X), i.e. a new fs; two
+  points at least min_separation_per_width x width apart give Lm and 1/Cm.
+"""
+from __future__ import annotations
+
+import cmath
+from dataclasses import dataclass
+import math
+
+import numpy as np
+
+from engine import Measurement, finite
+from models import model_v2_1 as model
+
+SQ8 = 2*math.sqrt(2)
+
+
+@dataclass(frozen=True)
+class Estimate:
+    c0: float
+    rm: float
+    lm: float
+    cm: float
+
+    @property
+    def fs(self) -> float:
+        return 1/(2*math.pi*math.sqrt(self.lm*self.cm))
+
+    @property
+    def q(self) -> float:
+        return 2*math.pi*self.fs*self.lm/self.rm
+
+    @property
+    def width(self) -> float:
+        """Half-power width of the motional branch, fs/Q."""
+        return self.fs/self.q
+
+    def bvd(self) -> model.BVD:
+        return model.BVD(c0=self.c0, rm=self.rm, lm=self.lm, cm=self.cm, qm=self.q, fs=self.fs)
+
+
+def from_bvd(b: model.BVD) -> Estimate:
+    return Estimate(b.c0, b.rm, b.lm, b.cm)
+
+
+def design_prior() -> Estimate:
+    """The configured design file's BVD: what the controller knows before any measurement."""
+    return from_bvd(model.BASE_BVD)
+
+
+def port_admittance(m: Measurement) -> complex | None:
+    """Y = I/V at the transducer port; None without a port phase."""
+    if m.phase_port_deg is None or not finite(m.vpp, m.irms, m.phase_port_deg) or m.vpp <= 0 or m.irms <= 0:
+        return None
+    return (m.irms/(m.vpp/SQ8))*cmath.exp(-1j*math.radians(m.phase_port_deg))
+
+
+def admittance(f: float, est: Estimate) -> complex:
+    w = 2*math.pi*f
+    return 1j*w*est.c0 + 1/(est.rm + 1j*(w*est.lm - 1/(w*est.cm)))
+
+
+def motional(f: float, y: complex, c0: float) -> complex:
+    return 1/(y - 1j*2*math.pi*f*c0)
+
+
+def fit_bvd(frequency_Hz, y) -> tuple[Estimate, float] | None:
+    """BVD from port admittances, with its relative RMS residual.
+
+    For a given C0 the motional branch is a weighted linear least squares
+    (weights |Ym|^2, heavier near resonance). C0 is taken on 401 points of
+    [0, 2 max|Im(Y)/w|], physical fits only (all three positive), then refined
+    by golden section between the neighbours of the best one. A single golden
+    section falls into non-physical minima: near resonance Im(Y)/w is far
+    above C0 (review/30). None when no physical fit exists.
+    """
+    f = np.asarray(frequency_Hz, dtype=float)
+    y = np.asarray(y, dtype=complex)
+    if len(f) < 5 or np.ptp(f) <= 0:
+        return None
+    w = 2*np.pi*f
+    w0 = float(np.median(w))
+    u = w/w0
+
+    def solve(c0):
+        ym = y - 1j*w*c0
+        z = 1/ym
+        wt = np.abs(ym)**2
+        rm = float(np.sum(wt*z.real)/np.sum(wt))
+        a = np.column_stack([u, -1/u])*np.sqrt(wt)[:, None]
+        (p, q), *_ = np.linalg.lstsq(a, z.imag*np.sqrt(wt), rcond=None)
+        lm, dinv = p/w0, q*w0
+        fit = 1j*w*c0 + 1/(rm + 1j*(lm*w - dinv/w))
+        return float(np.sum(np.abs(fit-y)**2)), (c0, rm, lm, dinv)
+
+    def resid(c0):
+        r, (_, rm, lm, dinv) = solve(c0)
+        return r if (rm > 0 and lm > 0 and dinv > 0) else math.inf
+
+    grid = np.linspace(0., 2*float(np.max(np.abs(y.imag/w))), 401)
+    res = np.array([resid(c) for c in grid])
+    k = int(np.argmin(res))
+    if not math.isfinite(res[k]):
+        return None
+    lo, hi = grid[max(k-1, 0)], grid[min(k+1, len(grid)-1)]
+    g = (math.sqrt(5)-1)/2
+    x1, x2 = hi-g*(hi-lo), lo+g*(hi-lo)
+    r1, r2 = resid(x1), resid(x2)
+    for _ in range(60):
+        if r1 < r2:
+            hi, x2, r2 = x2, x1, r1
+            x1 = hi-g*(hi-lo)
+            r1 = resid(x1)
+        else:
+            lo, x1, r1 = x1, x2, r2
+            x2 = lo+g*(hi-lo)
+            r2 = resid(x2)
+    r, (c0, rm, lm, dinv) = solve(0.5*(lo+hi))
+    if not (rm > 0 and lm > 0 and dinv > 0):
+        return None
+    return Estimate(c0, rm, lm, 1/dinv), math.sqrt(r/len(f))/float(np.mean(np.abs(y)))
+
+
+def update(est: Estimate, points, min_separation_per_width: float) -> Estimate | None:
+    """points: (frequency_Hz, Zm) in time order. Rm and fs from the last point;
+    Lm from the last two first, when they are at least min_separation_per_width
+    x width apart (the slope's noise falls with the separation). None when the
+    data do not fit a BVD (1/Cm or R not positive)."""
+    lm = est.lm
+    if len(points) >= 2:
+        (fa, za), (fb, zb) = points[-2], points[-1]
+        if abs(fb-fa) >= min_separation_per_width*est.width:
+            wa, wb = 2*math.pi*fa, 2*math.pi*fb
+            det = wa/wb - wb/wa
+            two = (za.imag/wb - zb.imag/wa)/det
+            if two > 0:
+                lm = two
+    f, z = points[-1]
+    w = 2*math.pi*f
+    dinv = w*(lm*w - z.imag)
+    if dinv <= 0 or z.real <= 0:
+        return None
+    return Estimate(est.c0, float(z.real), lm, 1/dinv)
+
+
+class PlantModel:
+    """The estimate behind the declared source and network (model.BASE_MATCH,
+    model.BASE_RS, the calibrated source), scaled by k: the measured port
+    voltage per unit drive over the predicted one at the held point. k = 1
+    while the declared network still holds; it is the only place where a
+    network change shows, since the port admittance does not depend on it."""
+
+    def __init__(self, cfg: dict, est: Estimate):
+        self.cfg = cfg
+        self.est = est
+        self.k = 1.0
+        self.points = model.current_points(cfg)
+
+    def unit(self, f) -> dict:
+        scenario = model.Scenario('ADMITTANCE_ESTIMATE', 'estimate', 'estimate', 'estimate',
+                                  'controller estimate behind the declared network',
+                                  self.est.bvd(), model.BASE_MATCH, model.BASE_RS)
+        return model.response(f, scenario, 1.0)
+
+    def transfer(self, m: Measurement) -> float:
+        return (m.vpp/m.amplitude)/float(self.unit(m.frequency_Hz)['vport_vpp'][0])
+
+    def headroom(self, f) -> np.ndarray:
+        """Amplitude at which f would reach a soft limit."""
+        q = self.unit(f)
+        return np.minimum(self.cfg['voltage_soft_Vpp']/(self.k*q['vport_vpp']),
+                          self.cfg['current_soft_Arms']/(self.k*model.limited_current(q, self.points)))
+
+    def power(self, f) -> np.ndarray:
+        """Soft-feasible port power with a <= 1."""
+        q = self.unit(f)
+        a = np.clip(np.minimum(self.cfg['voltage_soft_Vpp']/(self.k*q['vport_vpp']),
+                               self.cfg['current_soft_Arms']/(self.k*model.limited_current(q, self.points))),
+                    0., 1.)
+        return self.k**2*q['p_port_W']*a*a
+
+    def optimum(self, centre: float) -> tuple[float, float]:
+        """(frequency, power) of the model's soft-feasible maximum inside the
+        band, between centre and the estimated fs and admittance_search_span_widths
+        widths beyond either: a grid of 1/200 width, then 1 Hz around the best
+        point (a current limit puts a corner in the feasible power)."""
+        cfg = self.cfg
+        lo_band, hi_band = float(cfg['frequency_min_Hz']), float(cfg['frequency_max_Hz'])
+        span = cfg['admittance_search_span_widths']*self.est.width
+        lo = max(lo_band, min(centre, self.est.fs)-span)
+        hi = min(hi_band, max(centre, self.est.fs)+span)
+        if hi <= lo:
+            return centre, float(self.power(centre)[0])
+        step = max(1., self.est.width/200)
+        f = np.append(np.arange(lo, hi, step), hi)
+        k = int(np.argmax(self.power(f)))
+        f = np.arange(max(lo, f[k]-step), min(hi, f[k]+step)+0.5, 1.)
+        p = self.power(f)
+        k = int(np.argmax(p))
+        return float(f[k]), float(p[k])
