  "profiles": {
    "bvd": {"group": "BVD与匹配基线", "identity": "假设基线值／内部派生值，非实测", "frequency_scope": "本项目0.8–1.0 MHz电学扫描；基准0.9 MHz。不是实测适用频段。", "measurement_conditions": "无线下测量；线性、小信号、RMS相量、冻结匹配网络。几何、工作模态及脉冲占空比未辨识。", "adoption_reason": "保留可复算的历史假设基线，供算法与扰动对照；不能反推真实换能器结构。", "limitations": "与目标工作点自洽不等于器件参数已辨识。", "formal_use": true, "status": "假设／派生", "source_ids": ["design", "model"]},
    "operating": {"group": "设计工况与源", "identity": "用户设计工况／推荐量级，非器件辨识", "frequency_scope": "拟研究0.8–1.0 MHz，基准0.9 MHz；没有器件频带测量。", "measurement_conditions": "无实测；电压注明测点与Vpp，电流按RMS；连续波／脉冲及占空比尚未确定。", "adoption_reason": "沿用用户给出的可协商工况，保留既有可复现比较。", "limitations": "不能将推荐值解释为额定值、热限或临床边界。", "formal_use": true, "status": "设计工况", "source_ids": ["user_design"]},
    "control": {"group": "控制与验收假设", "identity": "假设控制／验收参数，非实测或器件额定值", "frequency_scope": "本项目0.8–1.0 MHz准稳态控制；载波瞬态未由这些时长保证。", "measurement_conditions": "Python离散准稳态；扫描、试探、保护均计时；无传感器或执行器延迟实测。", "adoption_reason": "采用当前冻结配置用于同口径对照；本次不重新调参，不声称最优。", "limitations": "需另做敏感性与硬件验证；数值来源是项目配置，不是文献推荐值。", "formal_use": true, "status": "假设／派生", "source_ids": ["config"]},
    "research": {"group": "负载研究原型（未接入）", "identity": "研究原型声明值；原始出处待补", "frequency_scope": "原型用于0.9 MHz附近的假设计算；没有材料实测频段依据。", "measurement_conditions": "假设圆形活塞和等效半波厚度；不是已确定器件结构。介质温度、压力、制备条件未登记为实测。", "adoption_reason": "保留原型数值以复现历史研究，不将其升级为正式模型默认参数。", "limitations": "需补齐材料、几何和介质的一手来源及适用性验证；不自动采用Saijo数值。", "formal_use": false, "status": "研究假设", "source_ids": ["load"]},
    "saijo": {"group": "Saijo文献参考（不采用）", "identity": "已发表样本统计，非本项目器件／负载辨识", "frequency_scope": "原文测量100–200 MHz；没有0.8–1.0 MHz适用性证据。", "measurement_conditions": "12例尸检人腹主动脉；福尔马林固定、冷冻10 μm切片、玻片载片，无石蜡包埋、测量时无盖玻片；SAM测区100×100 μm，25×25采样。", "adoption_reason": "仅登记文献参考，用于比较组织类型与审查参数量级；不写入运行配置。", "limitations": "均值±标准差（SD），不是置信区间或仪器精度；未测密度和声阻抗。不得由声速直接得到ρc，不得将高频衰减斜率直接外推至0.9 MHz。", "formal_use": false, "status": "文献参考／不采用", "source_ids": ["saijo"]},
    "pending": {"group": "待核实（禁止作为默认）", "identity": "未建立原始出处的历史说法", "frequency_scope": "未核实", "measurement_conditions": "组织、频段、温度及测量方法均未核实。", "adoption_reason": "保留问题线索并明确隔离，不作为默认参数或敏感性扫描上下界。", "limitations": "需逐端点找到原始论文、表格与条件；Saijo1998未测声阻抗，不能为此范围背书。", "formal_use": false, "status": "待核实", "source_ids": ["unverified_range"]}
  },
