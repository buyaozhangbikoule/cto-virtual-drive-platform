    {
      "name": "solver_status",
      "unit": "-",
      "required": true,
      "meaning": "NOT_RUN/PASS/FAIL",
      "source_class": "solver evidence"
    },
    {
      "name": "solver_log_path",
      "unit": "-",
      "required": true,
      "meaning": "Path to the solver completion log",
      "source_class": "solver evidence"
    }
  ]
}